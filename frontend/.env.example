# One of: "testnetBradbury" | "testnetAsimov" | "studionet" | "localnet"
NEXT_PUBLIC_GENLAYER_NETWORK=testnetBradbury

# Testnet Bradbury (production-like testnet with real AI/LLM workloads,
# persistent state -- recommended once your frontend is deployed
# publicly, not just running on localhost. Studionet's state is
# temporary and its RPC is meant for local iteration, not a public app.)
NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
NEXT_PUBLIC_GENLAYER_CHAIN_RPC_URL=https://rpc.testnet-chain.genlayer.com
NEXT_PUBLIC_CHAIN_ID=4221
NEXT_PUBLIC_EXPLORER_URL=https://explorer-bradbury.genlayer.com
NEXT_PUBLIC_CHAIN_EXPLORER_URL=https://explorer.testnet-chain.genlayer.com
# Faucet: https://testnet-faucet.genlayer.foundation

# Set automatically by `genlayer deploy`, or paste in manually.
# Paste it exactly as printed — don't change its casing. See
# lib/genlayer.ts for why that matters.
NEXT_PUBLIC_CONTRACT_ADDRESS=
